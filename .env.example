# Google AI Studio API Key (get free from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-api-key-here

# Model Configuration
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# RAG Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
DOCUMENTS_DIR=./documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# --- WEEK 3: Uncomment these for Vertex AI deployment ---
